{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (tests on)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASYMCRED_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASYMCRED_BUILD_TESTS": "ON",
        "ASYMCRED_WERROR": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ASYMCRED_BUILD_TESTS": "ON",
        "ASYMCRED_SANITIZE": "ON"
      }
    },
    {
      "name": "lib-only",
      "displayName": "Library only (no tests)",
      "binaryDir": "${sourceDir}/build-lib",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASYMCRED_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "arm64",
      "displayName": "Cross-compile aarch64 (build only)",
      "binaryDir": "${sourceDir}/build-arm64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASYMCRED_BUILD_TESTS": "ON",
        "ASYMCRED_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default",  "configurePreset": "default",  "configuration": "Debug" },
    { "name": "release",  "configurePreset": "release",  "configuration": "Release" },
    { "name": "asan",     "configurePreset": "asan",     "configuration": "Debug" },
    { "name": "lib-only", "configurePreset": "lib-only", "configuration": "Release" },
    { "name": "arm64",    "configurePreset": "arm64",    "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
